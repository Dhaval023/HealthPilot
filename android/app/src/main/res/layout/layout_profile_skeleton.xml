<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.8"
    app:shimmer_highlight_alpha="0.5"
    app:shimmer_base_color="@color/skeleton_bg"
    app:shimmer_highlight_color="@color/shimmer_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <View android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="16dp" />
        <View android:layout_width="150dp" android:layout_height="24dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="8dp" />
        <View android:layout_width="200dp" android:layout_height="16dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="32dp" />

        <View android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="12dp" />
        <View android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="12dp" />
        <View android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="12dp" />
        <View android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/skeleton_placeholder" android:layout_marginBottom="12dp" />

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
