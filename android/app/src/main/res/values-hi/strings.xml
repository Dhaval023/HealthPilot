    <!-- Onboarding Steps -->
    <string name="onboarding_title_1">HealthPilot में आपका स्वागत है</string>
    <string name="onboarding_desc_1">आपकी व्यापक फिटनेस यात्रा यहाँ से शुरू होती है। अपने दैनिक सारांश और लक्ष्यों को एक नज़र में ट्रैक करें।</string>
    <string name="onboarding_title_2">स्मार्ट वॉच कनेक्ट करें</string>
    <string name="onboarding_desc_2">अपनी घड़ी को कनेक्ट करके अपने कदम, हृदय गति, SpO2 और बहुत कुछ स्वचालित रूप से सिंक करें और सटीक डेटा के लिए कनेक्ट होने के बाद थोड़ा चलने का प्रयास करें।</string>
    <string name="onboarding_title_3">वर्कआउट</string>
    <string name="onboarding_desc_3">विभिन्न वर्कआउट में से चुनें और अपनी घड़ी या फोन पेडोमीटर के साथ अपने रीयल-टाइम आंकड़े ट्रैक करें।</string>
    <string name="onboarding_title_4">स्वास्थ्य और पोषण</string>
    <string name="onboarding_desc_4">अपने वजन के लक्ष्य (बढ़ाना/घटाना) निर्धारित करें, अपने भोजन को लॉग करें, और अपने लक्ष्य तक पहुँचने के लिए प्रोटीन, कार्ब्स और फैट जैसे मैक्रोज़ को ट्रैक करें।</string>
    <string name="onboarding_title_5">भोजन अनुस्मारक</string>
    <string name="onboarding_desc_5">भोजन अनुस्मारक शेड्यूल करके और अपने दैनिक कल्याण लक्ष्यों को देखकर ट्रैक पर रहें।</string>
    <string name="onboarding_title_6">दैनिक कल्याण</string>
    <string name="onboarding_desc_6">एक स्वस्थ जीवन शैली बनाए रखने के लिए अपने मूड, पानी के सेवन और दैनिक आदतों की निगरानी करें।</string>
    <string name="onboarding_title_7">प्रगति और रिपोर्ट</string>
    <string name="onboarding_desc_7">समय के साथ अपनी गतिविधि, वर्कआउट इतिहास और स्वास्थ्य उपलब्धियों की विस्तृत रिपोर्ट देखें।</string>
    <string name="onboarding_title_8">लक्ष्य और बीएमआई</string>
    <string name="onboarding_desc_8">अपने बीएमआई की निगरानी करें, अपने लक्षित दैनिक कदम और कैलोरी निर्धारित करें, और अपनी साप्ताहिक फिटनेस उपलब्धियों को ट्रैक करें।</string>
    <string name="onboarding_title_9">वेद से मिलें - आपका एआई सहायक</string>
    <string name="onboarding_desc_9">नमस्ते! मैं वेद हूँ, आपका व्यक्तिगत एआई फिटनेस साथी। मुझसे वर्कआउट, पोषण या स्वास्थ्य युक्तियों के बारे में कभी भी कुछ भी पूछें!</string>
    <string name="onboarding_title_10">व्यक्तिगत प्रोफ़ाइल</string>
    <string name="onboarding_desc_10">अपनी प्रोफ़ाइल को कस्टमाइज़ करें, सेटिंग्स समायोजित करें और अपने कनेक्टेड डिवाइस प्रबंधित करें।</string>
    <string name="onboarding_title_11">सब तैयार है!</string>
    <string name="onboarding_desc_11">🎉 आप पूरी तरह तैयार हैं! अपनी फिटनेस यात्रा शुरू करें और HealthPilot के साथ अपने लक्ष्यों को प्राप्त करें।</string>
